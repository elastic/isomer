# force unix-style LF (\n) line endings for source files
# this is necessary for prettier's linting
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# regenerated by `pnpm licenses:report`; collapsed in GitHub diffs
NOTICE.txt linguist-generated=true
THIRD_PARTY_LICENSES.md linguist-generated=true
