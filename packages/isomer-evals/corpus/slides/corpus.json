      "golden": {
        "type": "view",
        "title": "Self-managed or Serverless",
        "body": [
          {
            "type": "slideFrame",
            "footer": { "section": "Where to run search", "sectionNumber": "01" },
            "logo": false,
            "body": [
              {
                "type": "slideHeading",
                "title": "Serverless trades control for fewer pages at 3 a.m.",
                "lede": "Both run the same search; they differ in who upgrades it, how it grows, and how it is billed."
              },
              {
                "type": "slideTable",
                "columns": ["Concern", "Self-managed", "Serverless"],
                "rowHeaders": true,
                "rows": [
                  ["Upgrades", "Your team plans and runs them", "Elastic rolls them out"],
                  ["Scaling", "You size and add nodes", "Scales with load on its own"],
                  ["Cost model", "Infrastructure you provision", "Usage: ingest, storage, search"]
                ]
              }
            ]
          }
        ]
      }
