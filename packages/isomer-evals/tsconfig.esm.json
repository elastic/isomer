{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "target": "ES2020",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Node",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "outDir": "lib/esm",
    "module": "ESNext",
    "sourceMap": true,
    "inlineSources": true,
    "incremental": true,
    "tsBuildInfoFile": "lib/esm/.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.fixtures.ts"]
}
