{
  "schemaVersion": 1,
  "suite": "takumi",
  "about": "What takumi costs a fresh Node process on its own, drawing the slides pack's `isomer-every-surface` deck: the parent renders the deck with the `snapshot` surface once, and each child loads only takumi, registers the theme's font faces and draws that input. `Loaded RSS` is after creating the backend, before any font registers; `Render RSS` is the peak above it, and `RSS after` is after the run, a GC and, for `pdf-close`, `close()`. `Growth` is how much `RSS after` rose past the first pass of a repeated row. Native memory and the PDF worker's show only in RSS; `Heap after` is the main thread's alone. Per-output time is the median; under a burst it includes the wait for one of the libuv thread pool's threads, and `UV_THREADPOOL_SIZE` is in the environment. Report only: nothing here is bounded yet.",
  "environment": {
    "node": "v22.22.0",
    "v8": "12.4.254.21-node.33",
    "platform": "darwin",
    "arch": "arm64",
    "cpus": 14,
    "cpuModel": "Apple M4 Pro",
    "totalMemoryMb": 49152,
    "cgroupMemoryLimitMb": null,
    "nodeFlags": [
      "--disallow-code-generation-from-strings",
      "--expose-gc"
    ],
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": null,
      "MALLOC_ARENA_MAX": null,
      "UV_THREADPOOL_SIZE": null
    },
    "commit": "bc6d5d88f33318bcf087b64598700893839a238f",
    "packages": {
      "@elastic/isomer-sdk": "0.0.0-development",
      "@elastic/isomer-runtime": "0.0.0-development",
