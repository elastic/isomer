    "node": "v22.22.0",
    "v8": "12.4.254.21-node.33",
    "platform": "darwin",
    "arch": "arm64",
    "cpus": 14,
    "cpuModel": "Apple M4 Pro",
    "totalMemoryMb": 49152,
    "cgroupMemoryLimitMb": null,
    "nodeFlags": [
      "--disallow-code-generation-from-strings",
      "--expose-gc"
    ],
    "env": {
      "NODE_ENV": "production",
      "NODE_OPTIONS": null,
      "MALLOC_ARENA_MAX": null,
      "UV_THREADPOOL_SIZE": null
    },
    "commit": "4657656c7aac4b9b40fe1ddc0a2361f39be7cd76",
