{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "target": "ES2020",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "outDir": "lib/cjs",
    "module": "ESNext",
    "emitDeclarationOnly": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.fixtures.ts",
    "src/pdf_worker_source.cjs"
  ]
}
