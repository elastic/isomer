{
  "name": "@elastic/isomer-renderers-elastic-charts",
  "version": "0.0.0-development",
  "description": "Elastic Charts rendering for Isomer chart primitives.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-renderers-elastic-charts"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib",
    "!**/*.tsbuildinfo",
    "docs",
    "NOTICE.txt",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:compile && pnpm build:compile:esm && pnpm build:types",
    "build:clean": "rimraf lib/",
    "build:compile": "NODE_ENV=production babel src --out-dir=lib/cjs --extensions .js,.ts,.tsx --ignore \"**/*.test.ts,**/*.test.tsx,**/*.fixtures.ts\"",
    "build:compile:esm": "tsc --project ./tsconfig.esm.json",
    "build:types": "NODE_ENV=production tsc --project tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "isomer-studio dev --config isomer-studio.config.ts",
    "studio:stylesheet": "node studio/write_stylesheet.mjs"
  },
  "dependencies": {
    "@elastic/isomer-primitives-charts": "workspace:*",
    "@elastic/isomer-sdk": "workspace:*"
  },
  "peerDependencies": {
    "@elastic/charts": "^73.3.2",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.32 || ^0.6.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@elastic/charts": "73.3.2",
    "@elastic/isomer-runtime": "workspace:*",
    "@elastic/isomer-studio": "workspace:*",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.48"
  }
}
