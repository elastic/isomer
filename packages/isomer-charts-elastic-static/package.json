{
  "name": "@elastic/isomer-charts-elastic-static",
  "private": true,
  "version": "0.0.0-development",
  "description": "Static Elastic Charts drawings of Isomer chart Scenes on Node: released Elastic Charts mounted in jsdom, its canvases drawn through Skia, for images and PDF.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-charts-elastic-static"
  },
  "sideEffects": false,
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib",
    "!**/*.tsbuildinfo",
    "NOTICE.txt",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "pnpm build:clean && pnpm build:compile && pnpm build:compile:esm && pnpm build:types",
    "build:clean": "rimraf lib/",
    "build:compile": "NODE_ENV=production babel src --out-dir=lib/cjs --extensions .js,.ts,.tsx --ignore \"**/*.test.ts,**/*.test.tsx,**/*.fixtures.ts\"",
    "build:compile:esm": "tsc --project ./tsconfig.esm.json",
    "build:types": "NODE_ENV=production tsc --project tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "node ../../scripts/bench_charts.cjs --engine scripts/bench_engine.cjs",
    "bench:check": "node ../../scripts/bench_charts.cjs --engine scripts/bench_engine.cjs --check"
  },
  "dependencies": {
    "@elastic/eui": "123.1.0",
    "@elastic/eui-theme-borealis": "8.1.0",
    "@elastic/isomer-charts-elastic": "workspace:*",
    "@elastic/isomer-primitives-charts": "workspace:*",
    "@napi-rs/canvas": "1.0.11",
    "jsdom": "20.0.1"
  },
  "peerDependencies": {
    "@elastic/charts": "^73.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@elastic/charts": "73.3.2",
    "@elastic/isomer-image-takumi": "workspace:*",
    "@elastic/isomer-runtime": "workspace:*",
    "@elastic/isomer-sdk": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@types/jsdom": "20.0.1",
    "@types/react": "^18.3.31",
    "moment": "2.31.0",
    "moment-timezone": "^0.5.48",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
