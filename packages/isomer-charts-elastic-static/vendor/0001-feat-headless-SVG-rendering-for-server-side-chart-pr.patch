+
+import { CanvasPainter } from '../renderers/canvas/painter';
+
+/**
+ * A painter over `ctx` that draws one frame at final values and textured fills as their plain fill,
+ * so headless rendering creates no DOM elements.
+ * @internal
+ */
+export const headlessPainter = (ctx: CanvasRenderingContext2D) =>
+  new CanvasPainter(ctx, { animates: false, textures: false });
diff --git a/packages/charts/src/headless/render_bullet.test.tsx b/packages/charts/src/headless/render_bullet.test.tsx
