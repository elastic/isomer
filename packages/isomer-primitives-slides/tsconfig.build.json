{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo",
    "inlineSources": true
  },
  "exclude": ["**/*.test.ts", "**/*.fixtures.ts", "src/examples/**"],
  "references": [{ "path": "../isomer-sdk/tsconfig.build.json" }],
  "tsc-alias": {
    "resolveFullPaths": true,
    "resolveFullExtension": ".js"
  }
}
