    {
      "type": "view",
      "title": "Six terms carry the design",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Six terms carry the whole design"
            },
            {
              "type": "slideDefinitions",
              "items": [
                {
                  "term": "Composition",
                  "body": "The wire document, `{ type: 'view', title?, body: Node[] }`. It says **what** the answer is, never how it looks."
                },
                {
                  "term": "Primitive",
                  "body": "One node type: a Zod schema, a catalog entry, examples, and a renderer per surface."
                },
                {
                  "term": "Pack",
                  "body": "A vocabulary as a value. Packs compose; duplicate types are rejected by name."
                },
                {
                  "term": "Runtime",
                  "body": "Packs assembled into one validator, one parser, the surfaces, and a view registry."
                },
                {
                  "term": "Frame",
                  "body": "The document an image is drawn in: size, theme, surround. No frame, no `svg`."
                },
                {
                  "term": "Surface",
                  "body": "One output format, with `render` and `renderNode`. Every surface is synchronous."
                }
              ]
            }
          ],
          "logo": true,
          "tone": "page",
          "footer": {
            "brand": "Isomer",
            "section": "The model",
            "sectionNumber": "02",
            "url": "https://elastic.github.io/isomer"
          }
        }
      ]
    },
    {
