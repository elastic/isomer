      "title": "Four stages per render",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "A render validates, dispatches, wraps, and styles",
              "lede": "`react` skips validation, and only `html` and `svg` run the styles stage. Everything else is shared."
            },
            {
              "type": "slidePipeline",
              "start": "Composition",
              "end": "Output",
              "steps": [
                {
                  "title": "Validate",
                  "body": "A discriminated union over every primitive, then semantic passes. Errors are `{ path, message }`."
                },
                {
                  "title": "Dispatch",
                  "body": "Routes each node to its renderer for the surface, after the primitive’s `sanitize` hook."
                },
                {
                  "title": "Envelope",
                  "body": "Wraps the body: `section.isomer`, an `h1`, a Slack `header`, or a frame."
                },
                {
                  "title": "Styles",
                  "body": "Renders once to collect class names, then emits **only** that stylesheet."
                }
              ]
            }
          ],
          "logo": true,
