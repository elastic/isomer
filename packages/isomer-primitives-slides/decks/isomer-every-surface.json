    {
      "type": "view",
      "title": "A primitive is schema + catalog + renderers",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "A primitive is a schema, a catalog entry, and renderers"
            },
            {
              "type": "slideCode",
              "file": "metric.ts",
              "language": "ts",
              "text": "const metric = definePrimitive({\n  type: 'metric',\n  schema: z.object({ type: z.literal('metric'), label: z.string(), value: z.string() }),\n  catalog: {\n    purpose: 'State one measured value.',\n    useWhen: ['A single number answers the question.'],\n    avoidWhen: ['Several values belong together.'],\n  },\n  renderers: {\n    react: (node) => `${node.label}: ${node.value}`,\n    text: (node) => `${node.label}: ${node.value}`,\n    markdown: (node) => `**${node.label}**: ${node.value}`,\n  },\n});",
              "lineNumbers": {
                "highlight": "3, 5-7, 10-12"
              }
            },
            {
              "type": "slideSource",
              "text": "Isomer `README.md`, “A first composition”, trimmed"
