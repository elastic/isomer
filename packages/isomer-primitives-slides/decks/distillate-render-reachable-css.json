              "language": "ts",
              "text": "import { createEmotion } from '@elastic/distillate/emotion';\n\nconst { css, cx, injectGlobal } = createEmotion(distillery);\n\nconst card = css`\n  color: var(--eui-colors-ink);\n  &:hover { color: var(--eui-colors-accent); }\n  @media (min-width: 600px) { padding: 8px; }\n`;\n\n// <div className={cx('surface', card)} />",
