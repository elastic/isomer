    {
      "type": "view",
      "title": "Compact names take two passes",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Compact names take **two passes**",
              "lede": "Short names are assigned from the full collected set, so collect everything first, then resolve and print. Readable artifacts skip the second pass."
            },
            {
              "type": "slideCode",
              "file": "docs/guides/compact-artifacts.md",
              "language": "ts",
              "text": "const collector = distillery.artifactCollector('compact');\n\n// Pass 1: collect every handle the render wears. Don't read names yet.\nconst retained = collector.useHandles([panel.handles.root, panel.handles.tone.loud]);\n\n// Pass 2: names now depend on the whole set.\nconst resolver = collector.createResolver();\nconst className = retained.map((h) => resolver.className(h.key, h.readableName)).join(' ');\nconst css = distillery.renderStyles(collector, resolver);",
              "lineNumbers": {
                "highlight": "4, 7"
              }
            }
          ],
          "logo": false,
