    {
      "type": "view",
      "title": "Guardrails for payloads",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Guardrails catch what breaks **outside the app**",
              "lede": "A payload can look fine in development, where the host’s sheet happens to declare a var, and break in an inbox."
            },
            {
              "type": "slideList",
              "items": [
                {
                  "term": "./testing",
                  "body": "`assertVarRefsHaveDeclarations` fails any `var()` with no declaration."
                },
                {
                  "term": "ordering",
                  "body": "Base rules emit before every `@media` and `@container`, globally, so overrides win."
                },
                {
                  "term": "names",
                  "body": "Authored paths that join to the same class or var name throw at registration."
                },
                {
                  "term": "one copy",
                  "body": "A second loaded copy warns at import; variant tree-shaking would silently fail."
                },
                {
                  "term": "stylis",
                  "body": "The only runtime dependency, pinned to exactly 4.4.0."
                }
              ]
            }
          ],
          "logo": false,
          "tone": "page",
          "footer": {
