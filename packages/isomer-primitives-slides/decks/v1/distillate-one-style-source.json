    {
      "type": "view",
      "title": "Guardrails keep payloads honest",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Guardrails catch what breaks **outside the app**",
              "lede": "A payload can look fine in development and break in an email inbox."
            },
            {
              "type": "slideList",
              "items": [
                {
                  "term": "./testing",
                  "body": "`assertVarRefsHaveDeclarations` fails any `var()` with no declaration."
                },
                {
                  "term": "one copy",
                  "body": "A second loaded copy warns at import, since variants would stop tree-shaking."
                },
                {
                  "term": "names",
                  "body": "Paths that join to the same class or var name throw at registration."
                },
                {
                  "term": "stylis",
                  "body": "The only runtime dependency, pinned to exactly 4.4.0."
                }
              ]
            }
          ],
