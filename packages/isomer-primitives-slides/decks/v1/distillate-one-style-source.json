    {
      "type": "view",
      "title": "When to reach for it",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Reach for it when **styles leave the app**",
              "lede": "Its artifact path only pays off when CSS has to travel with HTML."
            },
            {
              "type": "slideSplit",
              "panes": [
                {
                  "label": "Use it when",
                  "tone": "primary",
                  "items": [
                    {
                      "type": "slideBulletList",
                      "items": [
                        "You ship a component library",
                        "Apps need a loadable stylesheet",
                        "Emails, SVGs, or replies need payloads",
                        "You want typed, prunable tokens"
                      ],
                      "marker": "check"
                    }
                  ]
                },
                {
                  "label": "Skip it when",
                  "items": [
                    {
                      "type": "slideBulletList",
                      "items": [
                        "You style one app directly",
                        "You need per-render class names",
                        "You rely on keyframes or `styled.*`",
                        "Your bundle can’t share one copy"
                      ],
                      "marker": "x"
                    }
                  ]
                }
              ],
              "divider": "rule",
              "footnote": "Migrating? `@elastic/distillate/emotion` keeps `css`, `cx`, and `injectGlobal` call sites."
            }
          ],
          "brand": "Distillate",
          "section": "When it fits",
          "sectionNumber": "03",
