    {
      "type": "view",
      "title": "Components render outside the app",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Components now render **outside the host app**",
              "lede": "Emails, SVG renders, agent replies, and exported HTML can’t load your stylesheet — their CSS has to travel with them."
            },
            {
              "type": "slideSplit",
              "panes": [
                {
                  "label": "Host app",
                  "tone": "accent",
                  "items": [
                    {
                      "type": "slideBulletList",
                      "items": [
                        "Loads one public stylesheet",
                        "Wants readable class names",
                        "Needs every variant and token"
                      ]
                    }
                  ]
                },
                {
                  "label": "Artifact",
                  "tone": "primary",
                  "items": [
                    {
                      "type": "slideBulletList",
                      "items": [
                        "Carries its own `<style>` block",
                        "Pays for every byte it ships",
                        "Breaks on any undeclared `var()`"
                      ]
                    }
                  ]
                }
              ],
              "divider": "rule",
              "footnote": "A library that serves both usually maintains **two style systems** — or ships the whole sheet everywhere."
            }
          ],
          "brand": "Distillate",
          "section": "The problem",
          "sectionNumber": "01",
          "logo": false,
