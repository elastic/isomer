    },
    {
      "type": "view",
      "title": "Bind, author, collect, emit",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Styles move through four steps: bind, author, collect, emit",
              "lede": "Collection is a side effect of rendering, so the CSS that ships matches the HTML that rendered."
            },
            {
              "type": "slidePipeline",
              "start": "theme",
              "end": "CSS",
              "steps": [
                {
                  "title": "Bind",
                  "body": "`createDistillery` fixes the prefix, tokens, and scope selector."
                },
                {
                  "title": "Author",
                  "body": "`createStyleModule` records typed declarations once, at load."
                },
                {
                  "title": "Collect",
                  "body": "Resolving a class name during render pulls in that handle."
                },
                {
                  "title": "Emit",
                  "body": "`renderStyles` writes a readable sheet or a compact payload."
                }
              ]
            }
          ],
          "brand": "Distillate",
          "section": "How it works",
          "sectionNumber": "02",
          "logo": false,
          "tone": "page",
          "url": "https://elastic.github.io/distillate"
        }
      ]
    },
    {
      "type": "view",
      "title": "Tokens are typed paths",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Tokens are **typed paths**, not strings",
              "lede": "The theme passed to `createDistillery` becomes a typed `tokens` tree. Modules interpolate it, and the engine records each dependency."
            },
            {
              "type": "slideCode",
              "panels": [
                {
                  "file": "distillery.ts",
                  "language": "ts",
                  "lines": [
                    "const distillery = createDistillery({",
                    "  prefix: 'eui',",
                    "  themeScope: '.eui-view',",
                    "  theme: {",
                    "    colors: {",
                    "      ink: lightDark('#111', '#eee'),",
                    "    },",
                    "    gap: cq('8px', '2cqi'),",
                    "  },",
                    "});"
                  ],
                  "highlightLines": [
                    6
                  ]
                },
                {
                  "file": "demo.ts",
                  "language": "ts",
                  "lines": [
                    "const demo = distillery.createStyleModule(",
                    "  'demo',",
                    "  ({ css, tokens }) => ({",
                    "    root: css`",
                    "      color: ${tokens.colors.ink};",
                    "      padding: ${tokens.gap};",
                    "    `,",
                    "  })",
                    ");"
                  ],
                  "highlightLines": [
                    5
                  ]
                }
              ]
            }
          ],
          "brand": "Distillate",
          "section": "How it works",
          "sectionNumber": "02",
          "logo": false,
          "tone": "page",
          "url": "https://elastic.github.io/distillate"
        }
      ]
    },
