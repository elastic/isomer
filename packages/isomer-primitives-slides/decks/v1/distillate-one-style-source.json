              "eyebrow": "A CSS engine for component libraries",
              "title": "Distillate",
              "tagline": "Author styles once. Ship **only what renders**.",
              "definition": {
                "term": "distillate n.",
                "text": "Concentrated CSS: the pure, fractionated styles extracted for a render."
              },
              "aside": {
                "type": "slideFanout",
