    {
      "type": "view",
      "title": "One component, two kinds of CSS",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "One component needs **two kinds of CSS**",
              "lede": "Inside an app it wants a public stylesheet. Rendered into an email, an image, or an agent reply, its CSS has to travel with the HTML."
            },
            {
              "type": "slideSplit",
              "panes": [
                {
                  "label": "Host app",
                  "tone": "accent",
                  "items": [
                    {
                      "type": "slideBulletList",
                      "items": [
                        "Loads one stylesheet up front",
                        "Wants readable, stable class names",
                        "Needs every variant and token"
                      ]
                    }
                  ]
                },
                {
                  "label": "Artifact",
                  "tone": "primary",
                  "items": [
                    {
                      "type": "slideBulletList",
                      "items": [
                        "Carries its own `<style>` block",
                        "Pays for every byte it ships",
                        "Breaks on any undeclared `var()`"
                      ]
                    }
                  ]
                }
              ],
              "divider": "rule",
              "footnote": "Distillate emits **both** from the same authored modules. Isomer’s HTML and image surfaces are its first consumer."
            }
          ],
          "brand": "Distillate",
          "section": "Why",
          "sectionNumber": "01",
          "logo": false,
          "tone": "page",
          "url": "https://elastic.github.io/distillate"
        }
      ]
    },
    {
      "type": "view",
      "title": "A slide needs 6% of the pack’s CSS",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "A typical slide needs **6% of the pack’s CSS**",
              "lede": "Isomer’s slides pack is one Distillate instance. Its HTML surface ships only what each slide’s render reached."
            },
            {
              "type": "slideDelta",
              "before": {
                "label": "Full stylesheet, KB",
                "value": "61"
              },
              "after": {
                "label": "Median slide, KB",
                "value": "3.6"
              },
              "change": "−94%",
              "body": "Across 47 real slides, from 1.6 to 6.0 KB each. These are readable names; compact names shrink it further."
            },
            {
              "type": "slideSource",
              "text": "`slideStylesheet()` vs. HTML-surface `<style>` bytes, Isomer deck and a Distillate draft, Sep 30, 2026"
            }
          ],
