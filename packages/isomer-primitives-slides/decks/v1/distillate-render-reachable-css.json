    {
      "type": "view",
      "title": "Guardrails for payloads",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Guardrails catch what breaks **outside the app**",
              "lede": "A payload can look fine in development, where the host’s sheet happens to declare a var, and break in an inbox."
            },
            {
              "type": "slideList",
              "items": [
                {
                  "term": "./testing",
                  "body": "`assertVarRefsHaveDeclarations` fails any `var()` with no declaration."
                },
                {
                  "term": "ordering",
                  "body": "Base rules emit before every `@media` and `@container`, globally, so overrides win."
                },
                {
                  "term": "names",
                  "body": "Authored paths that join to the same class or var name throw at registration."
                },
                {
                  "term": "one copy",
                  "body": "A second loaded copy warns at import; variant tree-shaking would silently fail."
                },
                {
                  "term": "stylis",
                  "body": "The only runtime dependency, pinned to exactly 4.4.0."
                }
              ]
            }
          ],
          "brand": "Distillate",
          "section": "In practice",
          "sectionNumber": "03",
          "logo": false,
          "tone": "page",
          "url": "https://elastic.github.io/distillate"
        }
      ]
    },
    {
      "type": "view",
      "title": "Migrate from Emotion in place",
      "body": [
        {
          "type": "slideFrame",
          "body": [
            {
              "type": "slideHeading",
              "title": "Emotion call sites keep working",
              "lede": "`@elastic/distillate/emotion` offers `css`, `cx`, and `injectGlobal` over the same registry. Through a collector, these handles tree-shake and compact like native ones."
            },
            {
              "type": "slideCode",
              "panels": [
                {
                  "file": "card.ts",
                  "language": "ts",
                  "lines": [
                    "import { createEmotion } from '@elastic/distillate/emotion';",
                    "",
                    "const { css, cx, injectGlobal } = createEmotion(distillery);",
                    "",
                    "const card = css`",
                    "  color: var(--eui-colors-ink);",
                    "  &:hover { color: var(--eui-colors-accent); }",
                    "  @media (min-width: 600px) { padding: 8px; }",
                    "`;",
                    "",
                    "// <div className={cx('surface', card)} />"
                  ],
                  "highlightLines": [
                    3
