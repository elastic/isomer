{
  "name": "@elastic/isomer-primitives-slides",
  "version": "0.0.0-development",
  "private": true,
  "description": "Slide-deck primitive pack for Isomer: the in-repo reference pack.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-primitives-slides"
  },
  "sideEffects": [
    "./lib/*/primitives/*/styles.js",
    "./lib/*/theme/modules.js",
    "./src/primitives/*/styles.ts",
    "./src/theme/modules.ts"
  ],
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    }
  },
  "files": [
    "lib",
    "!**/*.tsbuildinfo",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "pnpm build:clean && pnpm build:compile && pnpm build:compile:esm && pnpm build:types",
    "build:clean": "rimraf lib/",
    "build:compile": "NODE_ENV=production babel src --out-dir=lib/cjs --extensions .js,.ts,.tsx --ignore \"**/*.test.ts,**/*.fixtures.ts,src/examples/**\"",
    "build:compile:esm": "tsc --project ./tsconfig.esm.json",
    "build:types": "NODE_ENV=production tsc --project tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elastic/distillate": "^0.2.0",
    "@elastic/isomer-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@elastic/datemath": "5.0.3",
    "@elastic/eui": "123.1.0",
    "@elastic/eui-theme-borealis": "8.1.0",
    "@elastic/isomer-image-takumi": "workspace:*",
    "@elastic/isomer-runtime": "workspace:*",
    "@elastic/isomer-studio": "workspace:*",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^18.2.14",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "moment": "2.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rolldown": "1.2.13"
  }
}
