{
  "name": "@elastic/isomer-studio",
  "version": "0.0.0-development",
  "description": "Isomer Studio: a gallery, docs, JSX editor, and every-surface preview for any Isomer pack, run as a dev server, a static site, or a headless CI check.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-studio"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "isomer": {
    "packedFiles": [
      "lib/app/index.html",
      "lib/app/assets/studio.css",
      "lib/app/assets/codicon-*.ttf",
      "lib/app/assets/editor.worker.js",
      "lib/app/assets/ts.worker.js",
      "lib/app/assets/json.worker.js",
      "lib/app/assets/slack.css",
      "lib/app/assets/esbuild.wasm"
    ]
  },
  "bin": {
    "isomer-studio": "./bin/isomer-studio.js"
  },
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    }
  },
  "files": [
    "bin",
    "lib",
    "!**/*.tsbuildinfo",
    "docs",
    "README.md",
    "LICENSE.txt",
    "NOTICE.txt",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:compile && pnpm build:compile:esm && pnpm build:types && pnpm copy-files && pnpm build:assets",
    "build:clean": "rimraf lib/",
    "build:compile": "NODE_ENV=production babel src --out-dir=lib/cjs --extensions .js,.ts,.tsx --ignore \"**/*.test.ts,**/*.test.tsx,src/fixtures/**,src/test_setup.ts\"",
    "build:compile:esm": "tsc --project ./tsconfig.esm.json",
    "build:types": "NODE_ENV=production tsc --project tsconfig.types.json",
    "copy-files": "cp src/node/node_module.cjs lib/cjs/node/node_module.cjs",
    "build:assets": "node build/build_app_assets.mjs",
    "dev": "node --import tsx src/cli.ts dev --config ../isomer-primitives-slides/isomer-studio.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elastic/datemath": "5.0.3",
    "@elastic/eui": "123.1.0",
    "@elastic/eui-theme-borealis": "8.1.0",
    "@elastic/isomer-image-takumi": "workspace:*",
    "@elastic/isomer-runtime": "workspace:*",
    "@elastic/isomer-sdk": "workspace:*",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "moment": "2.31.0",
    "monaco-editor": "0.44.0",
    "prettier": "3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "slack-blocks-to-jsx": "1.1.2",
    "tsx": "4.23.15",
    "vite": "8.3.0"
  },
  "peerDependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6"
  }
}
