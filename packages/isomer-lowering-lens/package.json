{
  "name": "@elastic/isomer-lowering-lens",
  "version": "0.0.0-development",
  "description": "Portable planning of native ES|QL Lens saved objects, and projection of their responses.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-lowering-lens"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/cjs/index.js"
    },
    "./charts": {
      "types": "./lib/cjs/charts/index.d.ts",
      "import": "./lib/esm/charts/index.js",
      "require": "./lib/cjs/charts/index.js",
      "default": "./lib/cjs/charts/index.js"
    }
  },
  "files": [
    "lib",
    "!**/*.tsbuildinfo",
    "docs",
    "NOTICE.txt",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE.txt"
  ],
  "typesVersions": {
    "*": {
      "charts": [
        "./lib/cjs/charts/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:compile && pnpm build:compile:esm && pnpm build:types",
    "build:clean": "rimraf lib/",
    "build:compile": "NODE_ENV=production babel src --out-dir=lib/cjs --extensions .js,.ts,.tsx --ignore \"**/*.test.ts,**/*.test.tsx,**/*.fixtures.ts\"",
    "build:compile:esm": "tsc --project ./tsconfig.esm.json",
    "build:types": "NODE_ENV=production tsc --project tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elastic/isomer-primitives-charts": "workspace:*",
    "moment": "2.31.0",
    "moment-timezone": "0.6.1"
  },
  "peerDependencies": {
    "zod": "^4.5.4"
  }
}
