{
  "name": "@elastic/isomer-sdk",
  "version": "0.0.0-development",
  "description": "Shared primitive-pack toolkit for Isomer: the composition contract, validation, and rendering.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-sdk"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "lib/cjs/entries/index.js",
  "module": "lib/esm/entries/index.js",
  "types": "lib/cjs/entries/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/cjs/entries/index.d.ts",
      "import": "./lib/esm/entries/index.js",
      "require": "./lib/cjs/entries/index.js",
      "default": "./lib/cjs/entries/index.js"
    },
    "./html": {
      "types": "./lib/cjs/entries/html.d.ts",
      "import": "./lib/esm/entries/html.js",
      "require": "./lib/cjs/entries/html.js",
      "default": "./lib/cjs/entries/html.js"
    },
    "./slack": {
      "types": "./lib/cjs/entries/slack.d.ts",
      "import": "./lib/esm/entries/slack.js",
      "require": "./lib/cjs/entries/slack.js",
      "default": "./lib/cjs/entries/slack.js"
    },
    "./text": {
      "types": "./lib/cjs/entries/text.d.ts",
      "import": "./lib/esm/entries/text.js",
      "require": "./lib/cjs/entries/text.js",
      "default": "./lib/cjs/entries/text.js"
    },
    "./markdown": {
      "types": "./lib/cjs/entries/markdown.d.ts",
      "import": "./lib/esm/entries/markdown.js",
      "require": "./lib/cjs/entries/markdown.js",
      "default": "./lib/cjs/entries/markdown.js"
    },
    "./react": {
      "types": "./lib/cjs/entries/react.d.ts",
      "import": "./lib/esm/entries/react.js",
      "require": "./lib/cjs/entries/react.js",
      "default": "./lib/cjs/entries/react.js"
    },
    "./author": {
      "types": "./lib/cjs/author/index.d.ts",
      "import": "./lib/esm/author/index.js",
      "require": "./lib/cjs/author/index.js",
      "default": "./lib/cjs/author/index.js"
    },
    "./testing": {
      "types": "./lib/cjs/testing/index.d.ts",
      "import": "./lib/esm/testing/index.js",
      "require": "./lib/cjs/testing/index.js",
      "default": "./lib/cjs/testing/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "html": [
        "./lib/cjs/entries/html.d.ts"
      ],
      "slack": [
        "./lib/cjs/entries/slack.d.ts"
      ],
      "text": [
        "./lib/cjs/entries/text.d.ts"
      ],
      "markdown": [
        "./lib/cjs/entries/markdown.d.ts"
      ],
      "react": [
        "./lib/cjs/entries/react.d.ts"
      ],
      "author": [
        "./lib/cjs/author/index.d.ts"
      ],
      "testing": [
        "./lib/cjs/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "!**/*.tsbuildinfo",
    "NOTICE.txt",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:compile && pnpm build:compile:esm && pnpm build:types",
    "build:clean": "rimraf lib/",
    "build:compile": "NODE_ENV=production babel src --out-dir=lib/cjs --extensions .js,.ts,.tsx --ignore \"**/*.test.ts,**/*.fixtures.ts\"",
    "build:compile:esm": "tsc --project ./tsconfig.esm.json",
    "build:types": "NODE_ENV=production tsc --project tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20",
    "zod": "^4.5.4"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "parse5": "^7.3.0"
  }
}
