{
  "name": "@elastic/isomer-mcp",
  "version": "0.0.0-development",
  "description": "Agent tools for any Isomer runtime, with an MCP adapter: authoring guide, validation, rendering, and registered views.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git",
    "directory": "packages/isomer-mcp"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/entries/index.js",
  "module": "./dist/entries/index.js",
  "types": "./dist/entries/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/index.d.ts",
      "import": "./dist/entries/index.js",
      "require": "./dist/cjs/entries/index.js"
    },
    "./tools": {
      "types": "./dist/entries/tools.d.ts",
      "import": "./dist/entries/tools.js",
      "require": "./dist/cjs/entries/tools.js"
    }
  },
  "typesVersions": {
    "*": {
      "tools": [
        "./dist/entries/tools.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "NOTICE.txt",
    "THIRD_PARTY_LICENSES.md",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elastic/isomer-sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@elastic/isomer-primitives-slides": "workspace:*",
    "@elastic/isomer-runtime": "workspace:*"
  }
}
