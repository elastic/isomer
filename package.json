{
  "name": "@elastic/isomer-monorepo",
  "version": "0.0.0-development",
  "private": true,
  "description": "Isomer: a portable UI runtime that turns one typed Composition into React, HTML, SVG, PNG, Slack Block Kit, Markdown, and plain text.",
  "license": "Elastic-2.0",
  "author": "Elastic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elastic/isomer.git"
  },
  "bugs": {
    "url": "https://github.com/elastic/isomer/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build:types && pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm lint:es && pnpm lint:md && pnpm review-instructions --check",
    "lint:es": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:fix": "pnpm lint:es --fix",
    "lint:md": "markdownlint-cli2",
    "review-instructions": "node scripts/write_review_instructions.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/test_browser.js",
    "check:exports": "node scripts/check_exports.js",
    "check:declarations": "node scripts/check_declarations.js",
    "check:export-parity": "node scripts/check_export_parity.js",
    "check:pack-consumer": "node scripts/check_pack_consumer.js",
    "check:studio-consumer": "node scripts/check_studio_consumer.js",
    "check:module-graph": "node scripts/check_module_graph.js",
    "check:memory": "pnpm -r --if-present bench:check",
    "check:pack-contents": "node scripts/check_pack_contents.js",
    "licenses:report": "node scripts/licenses_report.js",
    "docs:assemble": "node scripts/assemble_package_docs.js",
    "docs:build": "pnpm docs:assemble && docs-builder",
    "docs:check": "node scripts/assemble_package_docs.js --check",
    "docs:dev": "node scripts/docs_dev.js",
    "studio:dev": "pnpm --filter @elastic/isomer-studio dev",
    "okf:check": "okf validate .okf/isomer && node scripts/check_okf_anchors.js && node scripts/write_okf_map.js --check",
    "okf:index": "okf index .okf/isomer && pnpm okf:map",
    "okf:map": "node scripts/write_okf_map.js",
    "verify": "pnpm verify:fast && pnpm verify:packed && pnpm test:browser && pnpm check:studio-consumer && pnpm check:memory",
    "verify:fast": "pnpm build && pnpm verify:static && pnpm test",
    "verify:static": "node scripts/run_parallel.js typecheck lint 'licenses:report --check'",
    "verify:packed": "pnpm check:export-parity && pnpm check:exports && pnpm check:declarations && pnpm check:pack-contents && pnpm check:module-graph && pnpm check:pack-consumer",
    "semantic-release": "semantic-release",
    "prepare": "husky",
    "bench:charts": "node scripts/bench_charts.cjs"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@elastic/charts": "73.3.2",
    "@elastic/isomer-agent-tools": "workspace:*",
    "@elastic/isomer-charts-elastic": "workspace:*",
    "@elastic/isomer-evals": "workspace:*",
    "@elastic/isomer-image-takumi": "workspace:*",
    "@elastic/isomer-primitives-charts": "workspace:*",
    "@elastic/isomer-primitives-slides": "workspace:*",
    "@elastic/isomer-runtime": "workspace:*",
    "@elastic/isomer-sdk": "workspace:*",
    "@elastic/isomer-studio": "workspace:*",
    "@eslint/js": "^9.25.1",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "1.64.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.15.3",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "20.0.1",
    "lint-staged": "^16.1.2",
    "markdownlint-cli2": "^0.23.3",
    "moment-timezone": "0.5.48",
    "prettier": "^3.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "semver": "7.8.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^4.1.11",
    "zod": "^4.5.4",
    "@elastic/isomer-primitives-vega": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "katex": "^0.18.2",
      "nwsapi": "2.2.2",
      "smol-toml": "^1.9.1",
      "vega-crossfilter": "5.1.0",
      "vega-dataflow": "6.1.0",
      "vega-encode": "5.1.0",
      "vega-event-selector": "4.0.0",
      "vega-expression": "6.1.0",
      "vega-force": "5.1.0",
      "vega-format": "2.1.0",
      "vega-functions": "6.1.1",
      "vega-geo": "5.1.0",
      "vega-hierarchy": "5.1.0",
      "vega-label": "2.1.0",
      "vega-loader": "5.1.0",
      "vega-parser": "7.1.0",
      "vega-projection": "2.1.0",
      "vega-regression": "2.1.0",
      "vega-runtime": "7.1.0",
      "vega-scale": "8.1.0",
      "vega-scenegraph": "5.1.0",
      "vega-statistics": "2.0.0",
      "vega-time": "3.1.0",
      "vega-transforms": "5.1.0",
      "vega-typings": "2.1.0",
      "vega-util": "2.1.0",
      "vega-view": "6.1.0",
      "vega-view-transforms": "5.1.0",
      "vega-voronoi": "5.1.0",
      "vega-wordcloud": "5.1.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "patchedDependencies": {
      "vega-canvas@2.0.0": "patches/vega-canvas@2.0.0.patch"
    }
  }
}
